<Project>
  <Import Project="$(RepoRoot)\Directory.Build.props" />
  <Import Project="$(NuGetPackageRoot)\microsoft.dotnet.build.tasks.packaging\$(MicrosoftDotNetBuildTasksPackagingVersion)\build\Microsoft.DotNet.Build.Tasks.Packaging.props" />
  <Import Project="$([MSBuild]::GetPathOfFileAbove(Microsoft.NET.Runtime.Emscripten.Common.props))" />

  <!--
    This package carries no payload. It exists so that consumers have a single stable package ID to track the
    version of the Emscripten packages by, since every other package this repo produces has the Emscripten
    version and the RID in its ID. This marker always retains the official build suffix, even when the
    shipping toolchain packages are stabilized for release.
  -->
  <PropertyGroup>
    <IsShipping>false</IsShipping>
    <SuppressFinalPackageVersion>true</SuppressFinalPackageVersion>
    <StableVersion></StableVersion>
    <PackageDescription>Records the version of the Emscripten packages built alongside it. Contains no files and is not meant to be referenced directly.</PackageDescription>
    <Description>Records the version of the Emscripten packages built alongside it. Contains no files and is not meant to be referenced directly.</Description>
  </PropertyGroup>

  <Import Project="$(NuGetPackageRoot)\microsoft.dotnet.build.tasks.packaging\$(MicrosoftDotNetBuildTasksPackagingVersion)\build\Microsoft.DotNet.Build.Tasks.Packaging.targets" />
  <Import Project="..\Directory.Build.targets" />
</Project>
